	partition RAW = m
		mode: import
		source =
			let
			    源 = Csv.Document(File.Contents("C:\SEM-BI报表数据\RAW.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    提升的标题 = Table.PromoteHeaders(源, [PromoteAllScalars = true]),
			    更改的类型 = Table.TransformColumnTypes(提升的标题, {
			        {"Date", type date}, {"Year", Int64.Type}, {"Month", Int64.Type}, {"Day", Int64.Type},
			        {"Week", type text}, {"SE", type text}, {"Device", type text}, {"Axis", type text},
			        {"Category", type text}, {"Keyword", type text},
			        {"Impressions", Int64.Type}, {"Clicks", Int64.Type}, {"Cost", type number}, {"AvgRank", type number},
			        {"Sessions", Int64.Type}, {"Bounces", Int64.Type}, {"Orders", Int64.Type},
			        {"Pageviews", Int64.Type}, {"Duration", Int64.Type}, {"Revenue", type number}})
			in
			    更改的类型
