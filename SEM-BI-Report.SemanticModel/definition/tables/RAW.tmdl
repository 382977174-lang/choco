		displayFolder: '04 同比'

		annotation PBI_FormatHint = {}

	measure 2017Sessions = CALCULATE(SUM(RAW[Sessions]), REMOVEFILTERS(RAW[Year]), RAW[Year] = 2017)
		formatString: '#,0'
		lineageTag: 72098953-27e258c246ae
		displayFolder: '04 同比'

		annotation PBI_FormatHint = {}

	measure 访问量同比增长% = DIVIDE([2018Sessions] - [2017Sessions], [2017Sessions])
		formatString: '+0.0%;-0.0%;0.0%'
		lineageTag: 20895249-243ac1047599
		displayFolder: '04 同比'

		annotation PBI_FormatHint = {}

	measure 日均访问2018 = DIVIDE(CALCULATE(SUM(RAW[Sessions]), RAW[Year] = 2018), CALCULATE(DISTINCTCOUNT(RAW[Date]), RAW[Year] = 2018))
		formatString: '#,0'
		lineageTag: 98974558-b60a64eab85a
		displayFolder: '04 同比'

		annotation PBI_FormatHint = {}

	measure 日均访问2017 = DIVIDE(CALCULATE(SUM(RAW[Sessions]), RAW[Year] = 2017), CALCULATE(DISTINCTCOUNT(RAW[Date]), RAW[Year] = 2017))
		formatString: '#,0'
		lineageTag: 23616252-3f35ceee2fc4
		displayFolder: '04 同比'

		annotation PBI_FormatHint = {}

